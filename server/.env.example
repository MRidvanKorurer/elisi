# Render Cron bu anahtarla /api/internal/payment-holds çağırır. Sunucu uyusa da 72 saat iptali işler.
CRON_SECRET=
PORT=5000
NODE_ENV=development
JWT_SECRET=degistir-uzun-rastgele-bir-deger
MONGO_URI=mongodb+srv://KULLANICI:SIFRE@cluster.mongodb.net/elisi

# Canlı storefront (Vercel) ve API (Render). Cookie, CORS ve İyzico dönüşü bunlar olmadan çalışmaz.
CLIENT_URL=https://nikbagstore.com
SERVER_URL=https://elisi-fxey.onrender.com
SITE_URL=https://nikbagstore.com
# Virgülle birden fazla origin. Render’da bunları tanımlayın.
CORS_ORIGIN=https://nikbagstore.com,https://www.nikbagstore.com,http://localhost:5173
# Mağaza ve API farklı domainde; tarayıcı çerezi için none + Secure gerekir.
COOKIE_SAMESITE=none

# Yerel geliştirme (server/.env, NODE_ENV=development):
# CLIENT_URL=http://localhost:5173
# SERVER_URL=http://localhost:5000
# SITE_URL=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173
# COOKIE_SAMESITE=lax

# Görseller ücretsiz Cloudinary'de tutulur (diske yazılmaz, kart gerekmez).
# https://cloudinary.com/users/register_free → Console → Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# İyzico — canlıda IYZICO_BASE_URL=https://api.iyzipay.com ve canlı anahtarlar
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Havale/EFT — süper admin / platform hesabı; checkout geçerli TR IBAN ister.
# Admin paneli veya SiteSetting doluysa o kullanılır, değilse bu env / PLATFORM_BANK.
BANK_NAME=Nik Bag
BANK_HOLDER=
BANK_IBAN=

# İletişim (footer, WhatsApp, yasal sayfalar)
COMPANY_NAME=Nik Bag
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_CITY=İstanbul
CONTACT_EMAIL=nikbagofficial@gmail.com
CONTACT_PHONE=
WHATSAPP_NUMBER=
TAX_OFFICE=
TAX_NUMBER=
MERSIS_NO=
INSTAGRAM_URL=https://www.instagram.com/nikbagofficial
FACEBOOK_URL=https://www.facebook.com/share/19fe1eojtZ/
TIKTOK_URL=https://www.tiktok.com/@nikbagstore
PINTEREST_URL=

# Yeni kayıt, satış, ürün onayı gibi site bildirimlerinin gideceği adres.
ADMIN_NOTIFY_EMAIL=nikbagofficial@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
# OPENAI_API_KEY=

# Gmail API. Site girişindeki GOOGLE_CLIENT_ID ile karıştırmayın.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM="Nik Bag <nikbagofficial@gmail.com>"

# WhatsApp bildirimleri: Meta Cloud API (QR/Chrome yok).
# developers.facebook.com → Uygulama → WhatsApp → API kurulumu
WHATSAPP_FROM_PHONE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ORDER=siparis_geldi
WHATSAPP_TEMPLATE_LANG=tr
WHATSAPP_TEST_PHONE=
SELLER_PHONE=
SUPER_ADMIN_PHONE=
# Yerelde QR denemek için: WHATSAPP_ALLOW_WEBJS=1
# WHATSAPP_DISABLED=1
