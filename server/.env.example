PORT=5000
NODE_ENV=development
JWT_SECRET=degistir-uzun-rastgele-bir-deger
MONGO_URI=mongodb+srv://KULLANICI:SIFRE@cluster.mongodb.net/elisi

# Canlı storefront ve API (HTTPS). Cookie ve İyzico dönüşü bunlar olmadan çalışmaz.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
SITE_URL=https://www.nikbag.com
# Virgülle birden fazla origin. Boşsa CLIENT_URL kullanılır.
CORS_ORIGIN=http://localhost:5173
# API ve site farklı domaindeyse: none
# COOKIE_SAMESITE=lax

# Görseller ücretsiz Cloudinary'de tutulur (diske yazılmaz, kart gerekmez).
# https://cloudinary.com/users/register_free → Console → Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# İyzico — canlıda IYZICO_BASE_URL=https://api.iyzipay.com ve canlı anahtarlar
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Havale — boşsa checkout havale seçeneği reddedilir
BANK_NAME=
BANK_IBAN=

# İletişim (footer, WhatsApp, yasal sayfalar)
COMPANY_NAME=Nik Bag
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_CITY=İstanbul
CONTACT_EMAIL=info@nikbag.com
CONTACT_PHONE=
WHATSAPP_NUMBER=
TAX_OFFICE=
TAX_NUMBER=
MERSIS_NO=
INSTAGRAM_URL=https://www.instagram.com/nikbag
FACEBOOK_URL=https://www.facebook.com/nikbag
PINTEREST_URL=https://tr.pinterest.com/nikbag

# Bu e-posta ile kayıtlı kullanıcı açılışta süper admin yapılır. Boşsa kimse otomatik yükseltilmez.
SUPERADMIN_EMAIL=

GOOGLE_CLIENT_ID=

GEMINI_API_KEY=
# OPENAI_API_KEY=
