{
  "functions": {
    "api/seo.js": {
      "includeFiles": "dist/index.html",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/urun/:id", "destination": "/api/seo?type=product&id=:id&locale=tr" },
    { "source": "/en/urun/:id", "destination": "/api/seo?type=product&id=:id&locale=en" },
    { "source": "/atolye/:slug", "destination": "/api/seo?type=atelier&id=:slug&locale=tr" },
    { "source": "/en/atolye/:slug", "destination": "/api/seo?type=atelier&id=:slug&locale=en" },
    { "source": "/kategori/:cat", "destination": "/api/seo?type=category&id=:cat&locale=tr" },
    { "source": "/en/kategori/:cat", "destination": "/api/seo?type=category&id=:cat&locale=en" },
    {
      "source": "/urunler",
      "has": [{ "type": "query", "key": "category", "value": "(?<cat>[a-z0-9-]+)" }],
      "destination": "/api/seo?type=category&id=:cat&locale=tr&legacy=1"
    },
    {
      "source": "/en/urunler",
      "has": [{ "type": "query", "key": "category", "value": "(?<cat>[a-z0-9-]+)" }],
      "destination": "/api/seo?type=category&id=:cat&locale=en&legacy=1"
    },
    { "source": "/en", "destination": "/api/seo?type=page&id=home&locale=en" },
    { "source": "/en/urunler", "destination": "/api/seo?type=page&id=products&locale=en" },
    { "source": "/en/atolyeler", "destination": "/api/seo?type=page&id=ateliers&locale=en" },
    { "source": "/en/satici-ol", "destination": "/api/seo?type=page&id=seller&locale=en" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
