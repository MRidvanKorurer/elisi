# API adresi
VITE_API_BASE_URL=http://localhost:5000/api

# Yayındaki alan adı: canonical, og:url ve sitemap bu değeri kullanır.
# Yayına almadan önce mutlaka kendi alan adınızla değiştirin.
VITE_SITE_URL=https://www.nikbag.com

# Google Identity (Web client ID — server GOOGLE_CLIENT_ID ile aynı)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized JavaScript origins: http://localhost:5173 ve canlı domain
VITE_GOOGLE_CLIENT_ID=

# İsteğe bağlı — schema telefonu. Asıl iletişim sunucu CONTACT_PHONE
VITE_CONTACT_PHONE=
