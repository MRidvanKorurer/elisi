# Canlı (Vercel Production / Preview). Build sırasında gömülür.
VITE_API_BASE_URL=https://elisi-fxey.onrender.com/api

# Canonical, og:url, sitemap ve robots bu değeri kullanır (apex; www CORS’ta ayrıca açılır).
VITE_SITE_URL=https://nikbagstore.com

# Yerel geliştirme (yalnızca makinenizdeki client/.env):
# VITE_API_BASE_URL=http://localhost:5000/api
# VITE_SITE_URL=http://localhost:5173

# Google Identity (Web client ID — server GOOGLE_CLIENT_ID ile aynı)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://nikbagstore.com
#   https://www.nikbagstore.com
VITE_GOOGLE_CLIENT_ID=

# İsteğe bağlı — schema telefonu. Asıl iletişim sunucu CONTACT_PHONE
VITE_CONTACT_PHONE=
